# Local development database (SQLite). For Supabase/Postgres, change the
# provider in prisma/schema.prisma to "postgresql" and set:
# DATABASE_URL="postgresql://user:password@host:5432/smartfleece"
DATABASE_URL="file:./dev.db"

# Optional: real email sending via Resend (https://resend.com). When BOTH
# variables are set, notifications are emailed and logged as SENT/FAILED;
# otherwise they are recorded in the NotificationLog in dev mode only.
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# MAIL_FROM="SmartFleece <onboarding@resend.dev>"
